{
  "name": "forkvlift",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @forkvlift/web dev",
    "dev:admin": "pnpm --filter @forkvlift/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:no-fixtures",
    "check:owners": "node scripts/check-owners.mjs",
    "check:no-fixtures": "node scripts/check-no-fixtures.mjs",
    "db:generate": "pnpm --filter @forkvlift/worker db:generate",
    "db:migrate:local": "pnpm --filter @forkvlift/worker db:migrate:local",
    "deploy:preview": "pnpm --filter @forkvlift/worker db:migrate:preview && pnpm --filter @forkvlift/web deploy:preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
