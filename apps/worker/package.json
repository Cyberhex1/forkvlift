{
  "name": "@forkvlift/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && vitest run -c vitest.integration.config.ts",
    "types": "wrangler types --env-interface Env --strict-vars=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@forkvlift/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "xss": "^1.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
